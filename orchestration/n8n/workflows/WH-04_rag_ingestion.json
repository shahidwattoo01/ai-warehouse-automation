      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json);\nreturn [{ json: { documents_indexed: items.length,\n  chunks_indexed: items.reduce((s, i) => s + (i.chunk_count || 0), 0), doc_ids: items.map(i => i.doc_id) } }];"
