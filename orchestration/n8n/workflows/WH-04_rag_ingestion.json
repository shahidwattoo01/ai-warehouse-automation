        "jsCode": "const CONFIG = { api_base: 'http://host.docker.internal:8000', chunk_size: 800, chunk_overlap: 120,\n  embedding_model: 'BAAI/bge-small-en-v1.5', min_retrieval_precision: 0.7, min_context_recall: 0.7 };\nconst b = $input.first().json.body || {};\nreturn [{ json: { ...CONFIG, force_reindex: b.force === true } }];"
      },
