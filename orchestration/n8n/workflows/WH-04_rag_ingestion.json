        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ collections: ['sop','robot_manual','safety','maintenance','inventory_policy'], force_reindex: $('Config').first().json.force_reindex }) }}"
