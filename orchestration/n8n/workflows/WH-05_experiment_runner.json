{
  "name": "WH-05 Experiment Runner (Baseline to RL)",
  "nodes": [
    {
      "parameters": {},
      "id": "1946ef24-86fe-50a3-8b5c-d61d3c7efaa2",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "color": "#2E9E5B"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "warehouse/run-experiments",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "e392d9e1-8cf3-56f8-8512-e337f206fc08",
      "name": "Run Experiments Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        272
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "warehouse-api-key",
          "name": "Warehouse API Key"
        }
      },
      "webhookId": "781496a4-9a56-593a-a236-e29ce4951b87",
      "color": "#2E9E5B"
    },
    {
      "parameters": {
        "jsCode": "const CONFIG = { api_base: 'http://host.docker.internal:8000', n8n_base: 'http://localhost:5678' };\nconst b = ($input.first().json.body) || {};\nconst ALL = ['random', 'heuristic', 'astar', 'ml', 'dynamic', 'agentic', 'rl'];\nconst modes = (Array.isArray(b.modes) && b.modes.length ? b.modes : ALL).filter(m => ALL.includes(m));\nreturn [{ json: { ...CONFIG,\n  experiment_name: b.name || `warehouse-ablation-${new Date().toISOString().slice(0, 10)}`,\n  modes, cycles_per_mode: Math.min(Number(b.cycles_per_mode) || 50, 1000),\n  seed: Number(b.seed) || 42, scenario: b.scenario || 'standard_day' } }];"
      },
      "id": "efd857ec-4fec-5cc9-950a-ae5074ed0154",
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        270,
        136
      ],
      "color": "#7F8C8D"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.api_base }}/experiments/create",
        "options": {
          "timeout": 30000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ name: $('Config').first().json.experiment_name, modes: $('Config').first().json.modes, cycles_per_mode: $('Config').first().json.cycles_per_mode, seed: $('Config').first().json.seed, scenario: $('Config').first().json.scenario }) }}"
      },
      "id": "09489ed2-7e6b-55ac-a840-3e0564a1fb75",
      "name": "01 Create Experiment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        540,
        136
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "warehouse-api-key",
          "name": "Warehouse API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst exp = $input.first().json.experiment_id;\nreturn cfg.modes.map((mode, i) => ({ json: { experiment_id: exp, mode, order: i + 1, total: cfg.modes.length } }));"
      },
      "id": "3728e2a1-75c9-509d-b380-7a7b851daacc",
      "name": "02 Build Mode Queue",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        810,
        136
      ],
      "color": "#7F8C8D"
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "56b31051-b106-5e38-b7fa-577c94fe5193",
      "name": "03 Loop Over Modes",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        1080,
        136
      ],
      "color": "#16A085",
      "notes": "Runs each experiment mode one after another",
      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.api_base }}/simulation/reset",
        "options": {
          "timeout": 30000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ experiment_id: $json.experiment_id, mode: $json.mode, seed: $('Config').first().json.seed, scenario: $('Config').first().json.scenario }) }}"
      },
      "id": "2d90adac-4fd9-5ef5-afe8-05c87d75c696",
      "name": "04 Reset Simulation (same seed)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1350,
        221
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "warehouse-api-key",
          "name": "Warehouse API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst cur = $input.first().json;\nconst mode = cur.mode ?? $('03 Loop Over Modes').first().json.mode;\nconst exp = cur.experiment_id ?? $('03 Loop Over Modes').first().json.experiment_id;\nreturn Array.from({ length: cfg.cycles_per_mode }, (_, i) => ({ json: { experiment_id: exp, mode, cycle: i + 1, seed: cfg.seed + i } }));"
      },
      "id": "06234f06-00a9-5bbd-8d99-847c2e394752",
      "name": "05 Expand Cycles",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1620,
        221
      ],
      "color": "#7F8C8D"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:5678/webhook/warehouse/run-cycle",
        "options": {
          "timeout": 180000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 0
            }
          }
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ mode: $json.mode, cycle: $json.cycle, seed: $json.seed, experiment_id: $json.experiment_id }) }}"
      },
      "id": "bc5550cb-82ef-5edd-ba5c-e9dcb590dabe",
      "name": "06 Run Cycle (calls WH-01)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1890,
        221
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "warehouse-api-key",
          "name": "Warehouse API Key"
        }
      },
      "onError": "continueRegularOutput",
      "notes": "Executes cycles for the current mode",
      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.api_base }}/evaluation/collect",
        "options": {
          "timeout": 30000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ experiment_id: $('03 Loop Over Modes').first().json.experiment_id, mode: $('03 Loop Over Modes').first().json.mode }) }}"
      },
      "id": "d7af3695-895b-5510-b92b-086101a820d4",
      "name": "07 Collect Mode Metrics",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2160,
        221
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "warehouse-api-key",
          "name": "Warehouse API Key"
        }
      },
      "executeOnce": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.api_base }}/evaluation/report",
        "options": {
          "timeout": 180000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ experiment_id: $('02 Build Mode Queue').first().json.experiment_id }) }}"
      },
      "id": "88c9a5d2-e3e3-5518-8ba8-12960e2ec098",
      "name": "08 Generate Comparison Report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1350,
        51
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "warehouse-api-key",
          "name": "Warehouse API Key"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1500
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.api_base }}/monitoring/event",
        "options": {
          "timeout": 30000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ type: 'experiment_complete', source: 'WH-05', experiment_id: $('02 Build Mode Queue').first().json.experiment_id, report: $json }) }}"
      },
      "id": "64514626-8a14-5098-9886-75a561e8e406",
      "name": "09 Notify Experiment Complete",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1620,
        51
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "warehouse-api-key",
          "name": "Warehouse API Key"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "content": "## WH-05 Experiment Runner\nRuns each mode with the SAME seed and scenario so results are comparable:\nrandom -> heuristic -> astar -> ml -> dynamic -> agentic -> rl.\nEach mode = previous mode + ONE capability (flags defined in WH-01 'Build Run Context').\n\nCycles run sequentially through WH-01. The backend pauses timer ticks while an experiment is active.\nOutput: metrics per mode + comparison tables/graphs from `/evaluation/report`.",
        "height": 210,
        "width": 760,
        "color": 4
      },
      "id": "76d684ca-7e49-51c2-b243-db5d984091fd",
      "name": "Note 12",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -350
      ]
    }
