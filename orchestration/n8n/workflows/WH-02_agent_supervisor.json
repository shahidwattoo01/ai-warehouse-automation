    },
    {
      "parameters": {
        "jsCode": "const CONFIG = { api_base: 'http://host.docker.internal:8000' };\nconst b = $input.first().json.body ?? {};\nconst task = String(b.task || '').replace(/[\\u0000-\\u001f\\u007f]/g, ' ').slice(0, 2000).trim();\nreturn [{ json: {\n  ...CONFIG, valid: task.length > 0, error: task ? null : 'task is required',\n  task_id: `agt_${$execution.id}`, task, source: b.source || 'unknown',\n  requested_by: b.requested_by || b.operator_id || 'system', entities: b.entities || {},\n  alerts: b.alerts || [], state_version: b.state_version ?? null, run_id: b.run_id ?? null,\n} }];"
      },
      "id": "19414c20-b8d2-53b1-9cbd-893baaf108e3",
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
