        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ task_id: $('Config').first().json.task_id, task: $('Config').first().json.task, source: $('Config').first().json.source, entities: $('Config').first().json.entities, alerts: $('Config').first().json.alerts, state_version: $('Config').first().json.state_version }) }}"
      },
      "id": "adb34d9c-c49a-5516-acd5-f9429f0eab49",
      "name": "01 Planner Agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1080,
        212
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "warehouse-api-key",
          "name": "Warehouse API Key"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1500,
      "notes": "Breaks the task into steps",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst plan = $input.first().json.plan || {};\nconst steps = Array.isArray(plan.steps) ? plan.steps : [];\nconst allowed = ['fleet', 'inventory', 'navigation', 'maintenance', 'vision', 'knowledge'];\nif (steps.length === 0) return [{ json: { task_id: cfg.task_id, step: 0, agent: 'none', goal: 'no steps planned', params: {} } }];\nreturn steps.slice(0, 8).map((s, i) => ({ json: {\n  task_id: cfg.task_id, step: s.step ?? i + 1, agent: allowed.includes(s.agent) ? s.agent : 'unknown',\n  goal: s.goal || '', params: s.params || {},\n} }));"
      },
      "id": "50d6917e-0bc6-5d4d-b768-9a6cd16dc022",
      "name": "02 Split Plan Steps",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1350,
        212
      ],
      "color": "#7F8C8D"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.api_base }}/agents/{{ $json.agent }}",
        "options": {
          "timeout": 60000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ task_id: $json.task_id, step: $json.step, goal: $json.goal, params: $json.params, requested_by: $('Config').first().json.requested_by }) }}"
      },
      "id": "43d535c8-cbed-5f11-84f2-54cfc32c144b",
      "name": "03 Invoke Specialist Agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1620,
        212
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "warehouse-api-key",
          "name": "Warehouse API Key"
        }
      },
      "onError": "continueRegularOutput",
      "notes": "Runs fleet / inventory / navigation / ... agent per step",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "const res = $json;\nlet src;\ntry { src = $('02 Split Plan Steps').item.json; }\ncatch (e) { src = { task_id: res.task_id, step: res.step, agent: res.agent, goal: res.goal }; }\nreturn { json: {\n  task_id: src.task_id, step: src.step, agent: src.agent, goal: src.goal,\n  ok: !res.error, error: res.error ?? null, result: res.result ?? null,\n  proposed_actions: res.proposed_actions ?? [], sources: res.sources ?? [],\n} };",
        "mode": "runOnceForEachItem"
      },
      "id": "632c5f63-d6a2-5df7-b75d-88ff17214f24",
      "name": "04 Normalize Agent Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1890,
        212
      ],
      "color": "#7F8C8D"
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst items = $input.all().map(i => i.json).sort((a, b) => a.step - b.step);\nconst actions = [], seen = new Set();\nfor (const it of items) {\n  if (!it.ok) continue;\n  for (const a of it.proposed_actions || []) {\n    const k = JSON.stringify([a.tool, a.args]);\n    if (seen.has(k)) continue;\n    seen.add(k);\n    actions.push({ ...a, step: it.step, agent: it.agent });\n  }\n}\nreturn [{ json: { task_id: cfg.task_id, steps: items, proposed_actions: actions, failed_steps: items.filter(i => !i.ok).length } }];"
      },
      "id": "ae64a85c-f3ca-5734-973a-1892125f2fd3",
      "name": "05 Aggregate Results & Actions",
      "type": "n8n-nodes-base.code",
