    {
      "parameters": {
        "jsCode": "const cfg = $('Config (Health)').first().json;\nconst health = $('A1 Backend Health').first().json || {};\nconst model = $('A2 Model Drift & Data Quality').first().json || {};\nconst fleet = $('A3 Fleet Heartbeats & Queues').first().json || {};\nconst alerts = [];\nif (health.error || health.status !== 'ok') alerts.push({ severity: 'critical', source: 'backend', message: 'Backend health check failed' });\nif (model.error) alerts.push({ severity: 'warning', source: 'ml', message: 'Model health endpoint unavailable' });\nelse if (model.drift_detected) alerts.push({ severity: 'warning', source: 'ml', message: `Drift detected in: ${(model.drifted_models || []).join(', ')}` });\nif (fleet.stale_robots > cfg.stale_robot_limit) alerts.push({ severity: 'warning', source: 'fleet', message: `${fleet.stale_robots} robot(s) not sending heartbeats` });\nif (fleet.queue_length > cfg.queue_threshold) alerts.push({ severity: 'warning', source: 'orders', message: `Order queue length ${fleet.queue_length} exceeds ${cfg.queue_threshold}` });\nreturn [{ json: { has_alerts: alerts.length > 0, alerts } }];"
      },
