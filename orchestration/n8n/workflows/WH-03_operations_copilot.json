      "parameters": {
        "jsCode": "const CONFIG = { api_base: 'http://host.docker.internal:8000', n8n_base: 'http://localhost:5678' };\nconst b = $input.first().json.body ?? {};\nconst message = String(b.message || '').replace(/[\\u0000-\\u001f\\u007f]/g, ' ').trim();\nconst errors = [];\nif (!message) errors.push('message is required');\nif (message.length > 1000) errors.push('message too long (max 1000 characters)');\nif (/(ignore|disregard)\\s+(all\\s+)?(previous|prior|above)\\s+instructions|reveal.*(system prompt|api key)/i.test(message))\n  errors.push('message rejected by input guardrail');\nreturn [{ json: { ...CONFIG, valid: errors.length === 0, errors, message,\n  operator_id: b.operator_id || 'anonymous', session_id: b.session_id || `sess_${$execution.id}` } }];"
      },
