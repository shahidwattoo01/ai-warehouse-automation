{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StateFrame",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "tick",
    "frame_type",
    "robots"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "run_id": {
      "type": "string"
    },
    "tick": {
      "type": "integer",
      "minimum": 0
    },
    "frame_type": {
      "enum": [
        "snapshot",
        "delta"
      ]
    },
    "robots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "cell",
          "heading",
          "status",
          "battery_pct"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "cell": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "heading": {
            "type": "number"
          },
          "status": {
            "type": "string"
          },
          "battery_pct": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
