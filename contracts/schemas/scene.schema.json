{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scene",
  "type": "object",
  "required": [
    "schema_version",
    "world",
    "zones",
    "static_objects"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "world": {
      "type": "object",
      "required": [
        "width",
        "depth",
        "cell_size"
      ]
    },
    "zones": {
      "type": "array"
    },
    "static_objects": {
      "type": "array"
    },
    "conveyor_network": {
      "type": "array"
    },
    "asset_index": {
      "type": "object"
    }
  }
}
