# Copy to .env and edit. Never commit .env.
API_KEY=dev-key
API_BASE_URL=http://localhost:8000
DATABASE_URL=postgresql+psycopg://warehouse:warehouse@localhost:5432/warehouse
QDRANT_URL=http://localhost:6333
MLFLOW_TRACKING_URI=http://localhost:5000
N8N_BASE_URL=http://localhost:5678

# Language model (hosted) and offline fallback
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_LOCAL_MODEL=llama3.1:8b
OLLAMA_URL=http://localhost:11434

# Simulation defaults
DEFAULT_SCENARIO=configs/scenarios/normal.yaml
DEFAULT_SEED=42
