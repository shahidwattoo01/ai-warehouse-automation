# Copy to .env and change every "change-me" before running anywhere but your own laptop.

# --- Database ---
POSTGRES_USER=warehouse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=warehouse_ai
DATABASE_URL=postgresql+psycopg://warehouse:change-me@postgres:5432/warehouse_ai

# --- Backend ---
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SIM_LAYOUT=large
SIM_SEED=42
SIM_TICK_HZ=2
# Record runs to PostgreSQL (run `python tasks.py migrate` first).
PERSIST_RUNS=true

# --- LLM / embeddings (TRD decisions D1, D2) ---
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/simulation/stream
