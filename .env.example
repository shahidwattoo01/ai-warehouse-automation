# Copy to .env and change every "change-me" before running anywhere but your own laptop.

# --- Database ---
POSTGRES_USER=warehouse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=warehouse_ai
DATABASE_URL=postgresql+psycopg://warehouse:change-me@postgres:5432/warehouse_ai

# --- Backend ---
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SIM_LAYOUT=large
SIM_SEED=42
SIM_TICK_HZ=2
# Record runs to PostgreSQL (run `python tasks.py migrate` first).
PERSIST_RUNS=true

# --- LLM / embeddings (TRD decisions D1, D2) ---
# Optional. Empty = the knowledge assistant answers with sentences from the documents (free,
# offline). LLM_PROVIDER=anthropic + LLM_API_KEY = Claude writes the answers from the same
# retrieved sections (each question is a paid API call). LLM_MODEL defaults to claude-opus-5-5.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/simulation/stream

# --- Authentication (app/core/auth.py) ---
# Long random secret that signs the access tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false            # true behind HTTPS

# --- Rate limits (app/core/ratelimit.py) -------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SCALE=1.0           # multiply every limit (e.g. 3 when a class shares one address)
TRUST_PROXY_HEADERS=false      # true only behind a reverse proxy that sets X-Forwarded-For

# --- Label printers (app/services/printers.py) ------------------------------------------------
# Network thermal printers that take ZPL on their raw port, by name: name=host[:port],...
# Example: LABEL_PRINTERS=pack1=10.0.0.21:9100,dock=10.0.0.22
LABEL_PRINTERS=

# --- Alert notifications (app/services/alerts.py, rules in configs/alert_rules.yaml) ---------
ALERT_EMAIL_TO=                # comma-separated; empty: no email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=warehouse-ai@localhost
ALERT_WEBHOOK_URL=             # Slack / Teams incoming webhook, or any URL taking JSON

# --- VDA 5050 robot interface (integration/vda5050) -------------------------------------------
VDA5050_ENABLED=true
MQTT_URL=                      # mqtt://user:password@host:1883 (mqtts:// for TLS); empty: in-process bus

# --- ERP connection (integration/erp) ---------------------------------------------------------
ERP_ENABLED=true
ERP_URL=                       # empty: in-process mock ERP; or http://127.0.0.1:8100 (python -m integration.erp.mock_erp)
ERP_API_KEY=                   # sent as X-API-Key to the ERP
ERP_WEBHOOK_SECRET=            # long random secret: signs orders the ERP pushes to the webhook
ERP_POLL_MINUTES=5
