{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API (reload)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "warehouse_ai.api.main:app",
        "--reload",
        "--port",
        "8000"
      ],
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Run simulation (normal)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_sim.py",
      "args": [
        "--scenario",
        "configs/scenarios/normal.yaml"
      ],
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Pytest: current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "${file}",
        "-x",
        "-s"
      ]
    }
  ]
}
